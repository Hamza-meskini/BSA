# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE files
.idea/
.vscode/*
!.vscode/settings.json

# Firebase
firebase-debug.log*
# If using Firebase emulators:
.firebase/
database-debug.log
firestore-debug.log
pubsub-debug.log
storage-debug.log
ui-debug.log

# Backend (Python/FastAPI)
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/.env
backend/.pytest_cache/
backend/htmlcov/
backend/.mypy_cache/
backend/analysis_results/
backend/data/

# Genkit State (if stored locally)
.genkit/log/
.genkit/trace/

# Ignore analysis results and data directories
analysis_results/
data/

# Ignore all files in these directories
analysis_results/*
data/*

# Keep the directories themselves
!analysis_results/.gitkeep
!data/.gitkeep

# Data files
data/
*.csv

# Analysis results
Backend/analysis_results/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

