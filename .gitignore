.firebase/
database-debug.log
firestore-debug.log
pubsub-debug.log
storage-debug.log
ui-debug.log

# Backend (Python/FastAPI)
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/.env
backend/.pytest_cache/
backend/htmlcov/
backend/.mypy_cache/
backend/analysis_results/
backend/data/

